@echo off
REM Kopieer naar r2-env.cmd (staat in .gitignore) en vul de waarden in.
REM Laden: r2-pdf-upload / r2-pdf-opschonen doen dit zelf.
REM Handmatig:  call scripts\r2-env.cmd

set "R2_ACCOUNT_ID=JOUW_ACCOUNT_ID"
set "R2_ACCESS_KEY_ID=JOUW_ACCESS_KEY_ID"
set "R2_SECRET_ACCESS_KEY=JOUW_SECRET_ACCESS_KEY"
set "R2_BUCKET=orthodox-ronl-bibliotheek-pdf"
set "R2_JURISDICTION=eu"
REM Optioneel i.p.v. R2_JURISDICTION:
REM set "R2_ENDPOINT=https://%R2_ACCOUNT_ID%.eu.r2.cloudflarestorage.com"

echo R2-omgevingsvariabelen gezet ^(bucket=%R2_BUCKET%, jurisdiction=%R2_JURISDICTION%^).
