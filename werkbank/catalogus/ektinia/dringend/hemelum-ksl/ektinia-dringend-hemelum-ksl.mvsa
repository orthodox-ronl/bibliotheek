# Dringende Litanie (Ksl)

@title "Сугубая ектения (11)"
# subtitle: Dringende Litanie - Ksl
@composer     "Traditioneel"
@bron "koormap Hemelum"
@copyright "CC BY-SA 4.0"

@do F4
@mode major
@oct S=0 A=0 T=-1 B=-1

@tekst "P: Zeggen wij allen ... geheel ons hart"
L:  Гос -по -ди, по -ми_ -луй_, |
S:  a    -   -   -   -    -     |a
A:  f    -   -   -   -    -     |f
T:  c    -   -   -   -    -     |c
B:  f    -   -   -   -    -     |f

@tekst "P: Heer, Albeheerser ... wees barmhartig"
# Moskovskaja
L:  Гос -по -ди, по -ми_ -луй_, ||
S:  a    -   -   -   \    /     ||a
A:  f    -   -   -   \    /     ||f
T:  c    -   -   -   -    -     ||c
B:  f    -   -   -   c-   f     ||f

@mscz-newline

@tekst "P: God, wees ons ... barmhartig"
L: |: Гос_ -по -ди, по -ми -луй, | Гос_ -по -ди, по -ми -луй, | Гос -по -ди, по -ми_ -луй_ :|
S: |: a     \   -   -   -   -    | a     \   -   -   -   -    | -    -   -   /   /    \    :|a
A: |: f     \   -   -   -   -    | f     \   -   -   -   -    | -    -   -   /   /    \    :|f
T: |: c     -   -   -   -   -    | c     -   -   -   -   -    | c    -   -   -   -    -    :|c
B: |: f     \3  -   -   -   -    | f     \3  -   -   -   -    | c-   -   -   -   c-   f    :|f

@tekst "P: Want Gij zijt ... der eeuwen"
L: А__ -минь_. ||
S:  a   -      ||a
A:  f   -      ||f
T:  c   -      ||c
B:  f   -      ||f
