# Dringende Litanie

@title "Dringende Litanie (11)"
@composer     "Traditioneel"
@bron "koormap Hemelum"
@copyright "CC BY-SA 4.0"

@do F4
@mode major
@oct S=0 A=0 T=-1 B=-1

@tekst "P: Zeggen wij allen ... geheel ons hart"
L:  Heer ont-ferm_ U__, |
S:  a    -   -     -    |a
A:  f    -   -     -    |f
T:  c    -   -     -    |c
B:  f    -   -     -    |f

@tekst "P: Heer, Albeheerser ... wees barmhartig"
# Moskovskaja
L:  Heer ont-ferm_ U__, ||
S:  a    -   \     /    ||a
A:  f    -   \     /    ||f
T:  c    -   -     -    ||c
B:  f    -   c-    f    ||f

@mscz-newline

@tekst "P: God, wees ons ... barmhartig"
L: |: Heer_, ont-ferm U, | Heer_, ont-ferm U, | Heer_, ont-ferm U, :|
S: |: a      \   -    -  | a      \   -    -  | -      /   /    \  :|a
A: |: f      \   -    -  | f      \   -    -  | -      /   /    \  :|f
T: |: c      -   -    -  | c      -   -    -  | c      -   -    -  :|c
B: |: f      \3  -    -  | f      \3  -    -  | c-     -   -    f  :|f

@tekst "P: Want Gij zijt ... der eeuwen"
L: A_-men_. ||
S: a  -     ||a
A: f  -     ||f
T: c  -     ||c
B: f  -     ||f
