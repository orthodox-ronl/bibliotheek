<!-- Kondak H. Marina, Toon 3 -->
[\\:] {-&/Ge}{/tooid} {\met} het {/sie}{/raad} der maag{/de}lijk{heid_} *
als met een onver{\welk_}{\ba}{\re} {\krans_}, *
en {/in} {/pur}per gekleed door het {-&\bloed} {/van} {/uw} {/mar}tel{dood_}, *
straalt gij heerlijk door wonderbare ge{/ne_.}zin{\gen_}, *
als het sieraad en de lof {\der} {/mar}{/te}{/&\la_&_}{\ren}, **
heilige martela{\res_} {\Ma_}{/&/&/&\&\&\&/ri-&-&-&-&-&-&_}{\na_}. [:]
