# Katechumenenlitanie (Ksl)

@title "Ектения об оглашенных (13)"
# subtitle: Katechumenenlitanie (Ksl)
@composer     "Traditioneel"
@bron "koormap Hemelum"
@copyright "CC BY-SA 4.0"

@do F4
@mode major
@oct S=0 A=0 T=-1 B=-1

@tekst "P: Katechumenen bidt de Heer"
L:  Гос -по -ди, по -ми_ -луй_, |
S:  a    -   -   -   -    -     |a
A:  f    -   -   -   -    -     |f
T:  c    -   -   -   -    -     |c
B:  f    -   -   -   -    -     |f

@tekst "invallen en 6x herhalen tijdens gebed van priester"
L:  Гос -по -ди, по -ми_ -луй_, | Гос -по -ди, по -ми_ -луй_, ||
S:  a    -   -   -   \    /     | a    -   -   -   /    \     ||a
A:  f    -   -   -   \    /     | f    -   -   -   /    \     ||f
T:  c    -   -   -   -    -     | c    -   -   -   -    -     ||c
B:  f    -   -   -   c-   f     | f    -   -   -   c-   f     ||f

@mscz-newline

L:  Те -бе_, Гос_ -по_ -ди__ |
S:  a   -    bb    -    a    |
A:  f   -    -     e-   f    |
T:  c   -    d     c    -    |
B:  f   -    bb-   c-   f    |

L: А__ -минь_. ||
S:  a   -      ||a
A:  f   -      ||f
T:  c   -      ||c
B:  f   -      ||f
