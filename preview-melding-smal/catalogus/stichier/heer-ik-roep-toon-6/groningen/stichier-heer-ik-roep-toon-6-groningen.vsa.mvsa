@title "Heer ik roep - Toon 6 (Groningen, bekende coupletten)"
@do F4
@mode major
@tempo 180
@oct S=0 A=0 T=-1 B=-1

@sectie cyclus-1
L: (Heer ik roep tot U ver)-hoor_ mij_, |
S: f                        \     /     |f
A: d-                       \     /     |d-
T: a                        \     /     |a
B: f                        \3    /3    |f

L: (ver-hoor) mij o Heer_., |
