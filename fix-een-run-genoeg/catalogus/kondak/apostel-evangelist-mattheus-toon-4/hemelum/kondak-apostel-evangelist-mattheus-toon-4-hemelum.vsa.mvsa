@title "H. Apostel en Evangelist Mattheüs"
@do F4
@mode major
@tempo 180
@oct S=0 A=0 T=-1 B=-1

@sectie cyclus-1
L: (Het tol-le-naars-juk hebt gij af-ge-wor-pen voor het juk der Ge)-rech_.-tig_-heid, |
S: a                                                                 -      /    \     |a
A: f                                                                 -      /    #\    |f#
T: c                                                                 -      /    -     |d
B: f                                                                 /2     \    \3    |d-

L: (om de wa-re rijk-dom te ver-za-me-len der he-mel-se) Wijs__-heid_\. |
S: Bb                                                    -      \       |a
A: g                                                     -      \       |f
T: d                                                     -      \       |c
B: g                                                     \4     /3      |f

@sectie herhaling
L: (Daar-om hebt gij ook ons het Woord der) Waar_-heid ge-leerd_, |
S: a                                        -     /    -  \       |a
A: f                                        -     /    -  #\      |f#
T: c                                        -     /    -  -       |d
B: f                                        /2    \    -  \3      |d-

L: (en ons op-ge-schrikt uit de zor-ge)-loos__-heid_ |
S: Bb                                   -      \     |a
A: g                                    -      \     |f
T: d                                    -      \     |c
B: g                                    \4     /3    |f

@sectie laatste
L: (door uw be-richt o-ver het Uur van het) Oor_&_ -deel_\. |
S: a                                        -   &\  /       |a
A: f                                        -   &\  /       |f
T: c                                        -   &-  -       |c
B: f                                        -   &\3 /3      |f
