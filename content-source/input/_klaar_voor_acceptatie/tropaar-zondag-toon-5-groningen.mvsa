@title "Tropaar van de zondag, toon 5"
@do F4
@mode major
@tempo 180
@oct S=0 A=-1 T=-1 B=-1
@speelplan 1, 2, 3, 4, 5, 6, 7, 8, 9

# template-frase '1' (1/9)
@blok 1
L: Komt_ ge-lo_-vi-gen_ |
S: g     -  /   \2 -    |f
A: e     -  /   -  -    |f+
T: c     -  -   \2 -    |a
B: c-    -  /3  -  -    |f
# template-frase '2' (2/9)
@blok 2
L: (laat ons aan-bid-den en be)-zin_&~&~-gen_, |
