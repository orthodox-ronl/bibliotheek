[/:] {En_}{\ge}{\len}, {/het.} {/Ont.}{/sla}pen der Al{/&\rei.&.}{\&+\ne.&.} {/&/aan.&.}{/&\schou}{\wend_}, *
za{/&/gen.&.} {/met} {\&\ver.&.}{/won}{\de}{\ring_}, *
hoe {b\de} {\Jonk_}vrouw {/op.}{/ge.}{/no}{\&+\men.&.} {/werd_}, *
{/van} {/de} {/aar_}{de.} {\naar} {\de} {\&+\He_&_}{/mel_}. * [/:]
