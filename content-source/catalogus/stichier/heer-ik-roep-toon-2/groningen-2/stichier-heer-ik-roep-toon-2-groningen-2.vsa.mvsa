@title "Heer ik roep - Toon 2 (couplet 2, Laat mijn gebed)"
@do F4
@mode major
@tempo 180
@oct S=0 A=0 T=-1 B=-2

@sectie cyclus-1
L: (Laat mijn ge-bed als wie)-rook_, |
S: Bb                         -      |Bb
A: g                          -      |g
T: c                          -      |c
B: c                          -      |c

L: (op-stij-gen voor Uw aan-ge)-zicht_, |
S: a                            /       |Bb
A: f                            /       |g
T: c                            -       |c
B: f+                           \3      |c

L: (de op-hef-fing van mijn han)-den_, |
S: d                             \3    |a
A: Bb                            \3    |f
T: f+                            \3    |c
B: Bb                            /4    |f+

@sectie herhaling
L: (zij een a-vond of)-fer_, |
S: a                   /     |Bb
A: f                   /     |g
T: c                   -     |c
B: f+                  \3    |c

@sectie laatste
L: (ver)-hoor_ mij_ o_ Heer__&~&~&~\. |
S: c     /     \    \  \&/&\&\        |g
A: a     /     \    \  \&/&\&\        |e-
T: f+    -     -    -  \2&\&-&-       |c
B: f+    -     -    -  /2&/&\&\5      |c
