@title "Heer ik roep - Toon 3 (couplet 1)"
@do F4
@mode major
@tempo 180
@oct S=0 A=-1 T=-1 B=-1

L: (Heer ik roep tot U ver-hoor) mij_, |
S: g                             -     |g
A: e                             -     |e
T: c                             -     |c
B: f                             -     |f

L: (ver-hoor mij o) Heer_, |
S: g                \2     |e-
A: e                \2     |c
T: c                \2     |a
B: f                \7     |f-

L: (Heer ik roep tot U ver-hoor) mij_, |
S: g                             -     |g
A: e                             -     |e
T: c                             -     |c
B: f                             -     |f

L: (sla acht op de stem van mijn sme-)-king_, |
S: g                                   \2     |e-
A: e                                   \2     |c
T: c                                   \2     |a
B: f                                   \7     |f-

L: (wan-neer ik tot U) roep_, |
S: g                   -      |g
A: e                   -      |e
T: c                   -      |c
B: f                   -      |f

L: ver-hoor mij o Heer__\. |
S: g   -    -   - \2       |e-
A: e   -    -   - \2       |c
T: c   -    -   - \2       |a
B: f   -    -   - \7       |f-
