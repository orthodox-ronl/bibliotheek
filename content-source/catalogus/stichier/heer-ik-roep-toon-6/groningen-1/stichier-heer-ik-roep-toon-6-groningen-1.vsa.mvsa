@title "Heer ik roep - Toon 6 (couplet 1)"
@do F4
@mode major
@tempo 180
@oct S=0 A=0 T=-1 B=-1

@sectie cyclus-1
L: (Heer ik roep tot U ver)-hoor_ mij_, |
S: f                        \     /     |f
A: d-                       \     /     |d-
T: a                        \     /     |a
B: f                        \3    /3    |f

L: (ver-hoor)_ mij o Heer_, |
S: g           \   - /      |g
A: e-          \   - /      |e-
T: Bb          \   - /      |Bb
B: g           \   - /      |g

L: (Heer ik roep tot U ver)-hoor_&~ mij_, |
S: a                        \    &\ \     |e-
A: f                        \    &\ \     |c-
T: c                        \    &\ \     |g
B: f                        /    &\ \3    |c-

@sectie herhaling
L: (sla acht op de stem van mijn) sme_-king_, |
S: f                              \    /      |f
A: d-                             \    /      |d-
T: a                              \    /      |a
B: f                              \3   /3     |f

L: (wan-neer ik tot)_ U_ roep_, |
S: g                  \  \      |e-
A: e-                 \  \      |c-
T: Bb                 \  \      |g
B: g                  \  \3     |c-

@sectie laatste
L: (ver)-hoor_.&~&~ mij_ o_ Heer__\. |
S: f     /2    &\&- \    \  /        |f
A: d-    /2    &\&- \    \  /        |d-
T: a     /2    &\&- \    \  /        |a
B: f     -     &/&- \    \3 /3       |f
