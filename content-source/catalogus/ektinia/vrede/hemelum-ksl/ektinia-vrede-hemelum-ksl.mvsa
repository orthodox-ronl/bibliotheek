# Vredeslitanie (Ksl)

@title "Великая ектения (1a)"
@composer     "Traditioneel"
@bron "koormap Hemelum"
@copyright "CC BY-SA 4.0"

@do F4
@mode major
@oct S=0 A=0 T=-1 B=-1

@tekst "P: Gezegend ... der eeuwen"
L:  А_-минь__ |
S:  a  -      |a
A:  f  -      |f
T:  c  -      |c
B:  f  -      |f

@tekst "P: Laat ons de Heer in vrede bidden"
L:  Гос -по -ди, по -ми_ -луй_, ||
S:  a    -   -   -   -    -     ||a
A:  f    -   -   -   -    -     ||f
T:  c    -   -   -   -    -     ||c
B:  f    -   -   -   -    -     ||f

@tekst "P: Om de hemelse ... bidden"
L: |: Гос -по -ди, по -ми_ -луй_, |  Гос -по -ди, по -ми_ -луй_, :|
S: |: a    -   -   -   \    /     |  a    -   -   -   /    \     :|a
A: |: f    -   -   -   \    /     |  f    -   -   -   /    \     :|f
T: |: c    -   -   -   -    -     |  c    -   -   -   -    -     :|c
B: |: f    -   -   -   c-   f     |  f    -   -   -   c-   f     :|f

@tekst "P: Onze Alheilige ... ons leven aan"
L:  Те -бе_, Гос_ -по_ -ди__ |
S:  a   -    bb    -    a    |
A:  f   -    -     e-   f    |
T:  c   -    d     c    -    |
B:  f   -    bb-   c-   f    |

@tekst "P: Want van U ... der eeuwen"
L: А__ -минь__ ||
S:  a   -      ||a
A:  f   -      ||f
T:  c   -      ||c
B:  f   -      ||f
