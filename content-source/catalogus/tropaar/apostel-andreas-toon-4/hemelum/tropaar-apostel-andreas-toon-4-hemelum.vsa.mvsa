@title "tropaar-apostel-andreas-toon-4-hemelum"
@do F4
@mode major
@tempo 180
@oct S=0 A=0 T=-1 B=-1

@sectie cyclus-1
L: (Gij zijt de Eerst-ge-roe-pe-ne der A)-pos_-te_-len_, |
S: a                                      -    /   \     |a
A: f                                      -    /   #\    |f#
T: c                                      -    /   -     |d
B: f                                      /2   \   \3    |d-

L: (en de broe-der van) Pe_-tros_\. |
S: Bb                   -   \       |a
A: g                    -   \       |f
T: d                    -   \       |c
B: g                    \4  /3      |f

@sectie herhaling
L: (Bid daa-rom, hei-li-ge An-dre-as, tot de) Mees_-ter van het heel-al_, |
S: a                                          -     -   /   -   -    \    |a
A: f                                          -     -   /   -   -    #\   |f#
T: c                                          -     -   /   -   -    -    |d
B: f                                          /2    -   \   -   -    \3   |d-

L: (om aan de we-reld vre-de te) schen__-ken_, |
S: Bb                            -       \     |a
A: g                             -       \     |f
T: d                             -       \     |c
B: g                             \4      /3    |f

@sectie laatste
L: (en aan on-ze zie-len de gro-te ge)-na_&_-de_\. |
S: a                                   -&/   \     |a
A: f                                   -&/   \     |f
T: c                                   -&/   \     |c
B: f                                   -&/   \     |f
