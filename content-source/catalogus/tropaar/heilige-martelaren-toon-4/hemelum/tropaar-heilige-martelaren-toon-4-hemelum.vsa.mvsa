@title "tropaar-heilige-martelaren-toon-4-hemelum"
@do F4
@mode major
@tempo 180
@oct S=0 A=0 T=-1 B=-1

@sectie cyclus-1
L: (Uw mar-te)-la_-ren, o Heer_, |
S: a           -   /    - \      |a
A: f           -   /    - #\     |f#
T: c           -   /    - -      |d
B: f           /2  \    - \3     |d-

L: (heb-ben door hun lij-den van U een on-be-der-fe-lij-ke kroon ont)-van_-gen_\. |
S: Bb                                                                 -    \      |a
A: g                                                                  -    \      |f
T: d                                                                  -    \      |c
B: g                                                                  \4   /3     |f

@sectie herhaling
L: (Zij heb-ben, God, zich in Uw) kracht_ ver_-heugd_, |
S: a                              -       /    \       |a
A: f                              -       /    #\      |f#
T: c                              -       /    -       |d
B: f                              /2      \    \3      |d-

L: (zo-dat zij hun beu-len o-ver)-won_-nen_, |
S: Bb                             -    \     |a
A: g                              -    \     |f
T: d                              -    \     |c
B: g                              \4   /3    |f

L: (en de mach-te-lo-ze aan-sla-gen van de de-mo-nen heb-ben) af_-ge_-schud_\. |
S: a                                                          -   /   \        |a
A: f                                                          -   /   #\       |f#
T: c                                                          -   /   -        |d
B: f                                                          /2  \   \3       |d-

@sectie laatste
L: (Ver-los door hun ge-be-den on-ze) zie_&_-len_\. |
S: a                                  -&\    /      |a
A: f                                  -&\    /      |f
T: c                                  -&-    -      |c
B: f                                  -&\3   /3     |f
